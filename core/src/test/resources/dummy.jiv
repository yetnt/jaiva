tsea "jaiva/threads"!
tsea "jaiva/file/io"!

kwenza t() ->
    khuluma("HII")!

    sleep(1000)!

    @ Thread should error, below is wrong
    khuluma("WHAT" / 0.3242)!
<~

kwenza clean(type, err) ->
    khuluma(type)!
    if (err~ > 0) ->
        khuluma(err)!
    <~
<~

thread(t, clean)!

khuluma("yo")!

maak str <- "C:\Users\ACER\Documents\code\jaiva\core\src\main\java\com\jaiva\interpreter\symbol\inf\BFMethod.java"!

maak conf <- f_read(str)!

maak read <- conf("read")!

maak lastVal!
@ EOF, since readByte throws EOFException and not some sentinetal, so for testing purposes
@ read in this specfic case will return false when the file is done.
nikhil (lastVal != false) ->
    lastVal <- read()! @ will be byte values converted to Longs between 0 and 255
    khuluma(lastVal)!
<~

conf("close")()!