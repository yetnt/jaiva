tsea "jaiva/threads"!
@ Constants for file reading and writing type inputs/keys
tsea "jaiva/file/bytes"!
@ Constants for continuous function keys
tsea "jaiva/continuous"!

@ Continuous
maak conf <- f_cwriter()!
    |> "C:\Users\ACER\Documents\Untitled.txt"!  @ file loc
    |> true!                                    @ Appends to the file

@ Java UTF-8 Uses the normal DataOutputStream modified UTF-8 encoding.
@ W_UTF8 can be used, but we wont know the length.
conf(C_OUTPUT)(W_JAVA_UTF8, "Hello World!!!")!
conf(C_OUTPUT)(W_JAVA_UTF8, "Other things")!
conf(C_FLUSH)()!
conf(C_CLOSE)()!

maak maxBytes <- 200!

kwenza t() ->
    maak cf <- f_creader()!
    |> "C:\Users\ACER\Documents\code\jaiva\core\src\test\resources\dummy.jiv"!
    maak read <- cf(C_INPUT)!
    maak eof <- cf(C_EOF)! @ A function which returns a boolean.

    maak collect <-|!
    maak lastVal!
    nikhil (eof()') ->
        lastVal <- read(R_BYTE)!
        sif (lastVal != idk) ?> collect <- arrLit(collect:::, lastVal)!
    <~

    khuluma("Self bytes:")!
    khuluma(collect)!

    cf(C_CLOSE)()!
<~

kwenza clean(type, err) ->
    khuluma(type)!
    sif (err~ > 0) ?> khuluma(err)!
<~

thread(t, clean)!

khuluma("yo")!

maak conf <- f_creader()!
|> "C:\Users\ACER\OneDrive\Music\scammerz.wav"!
maak read <- conf(C_READ)!
maak eof <- conf(C_EOF)!

maak collect <-|!
maak lastVal!
nikhil (eof()' && lastVal != false) ->
    lastVal <- read(R_BYTE)!
    if (lastVal != idk) ->
        collect <- arrLit(collect:::, lastVal)!
        sif (collect~ = maxBytes) ?> lastVal <- false!
    <~
<~

conf(C_CLOSE)()!

khuluma("The following bytes were found:")!
khuluma(collect)!
